{
  "$schema": "https://opencode.ai/routing.json",
  "version": "1.1.0",
  "description": "v1.1.0 retires the deepseek-v4-flash alias (see retired_models), restates DeepSeek as metered with an off-peak/peak price split (see cost_policy), and marks minimax small_model explicitly unset. Single Source of Truth (SSOT) for task→model routing. Consolidates the three formerly divergent tables: 36-model-router.sh task-profiles.json, scripts/ai-router.json, and .opencode/opencode-swarm.json agent map. The providers section mirrors src/data/providers.json (routing-relevant fields only). See src/data/README.md.",
  "defaults": {
    "default_provider": "deepseek",
    "default_model": "deepseek/deepseek-v4-pro",
    "fast_model": "deepseek/deepseek-flash",
    "fallback_chain": [
      "deepseek",
      "zai",
      "minimax"
    ]
  },
  "retired_models": {
    "deepseek-v4-flash": {
      "replacement": "deepseek-flash",
      "status": "retired",
      "note": "Legacy alias still accepted by the API, but the model behind it was retired: requests are served by DeepSeek-V4.1-Flash and billed at the Flash price. Never route to the alias."
    },
    "deepseek-v4-flash-vision-exp": {
      "replacement": "deepseek-flash",
      "status": "retired",
      "note": "Retired alongside deepseek-v4-flash; use deepseek-flash."
    }
  },
  "complexity_rules": {
    "simple": {
      "max_tokens": 2000,
      "provider": "deepseek",
      "model": "deepseek/deepseek-flash",
      "cost_per_1k": 0.00014,
      "examples": [
        "fix typo",
        "add comment",
        "rename variable",
        "format code"
      ]
    },
    "medium": {
      "max_tokens": 8000,
      "provider": "deepseek",
      "model": "deepseek/deepseek-v4-pro",
      "cost_per_1k": 0.00055,
      "examples": [
        "implement feature",
        "refactor module",
        "add tests",
        "write docs"
      ]
    },
    "complex": {
      "max_tokens": 64000,
      "provider": "deepseek",
      "model": "deepseek/deepseek-v4-pro",
      "thinking": true,
      "cost_per_1k": 0.00219,
      "examples": [
        "system design",
        "architecture review",
        "debug complex bug",
        "security audit"
      ]
    }
  },
  "task_routing": {
    "code_generation": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro"
    },
    "code_review": {
      "provider": "deepseek",
      "model": "deepseek-flash"
    },
    "testing": {
      "provider": "deepseek",
      "model": "deepseek-flash"
    },
    "documentation": {
      "provider": "deepseek",
      "model": "deepseek-flash"
    },
    "architecture": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "thinking": true
    },
    "security_audit": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "thinking": true
    },
    "devops": {
      "provider": "deepseek",
      "model": "deepseek-flash"
    },
    "ui_design": {
      "provider": "xai",
      "model": "grok-4.3"
    },
    "research": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "thinking": true
    },
    "refactoring": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro"
    },
    "debugging": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro"
    },
    "data_analysis": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro"
    }
  },
  "task_profiles": {
    "coding": {
      "description": "Primary coding, implementation, refactoring",
      "model": "deepseek/deepseek-v4-pro",
      "small_model": "deepseek/deepseek-flash",
      "fallback": [
        "zai/glm-5.2",
        "anthropic/claude-opus-4-8"
      ],
      "rationale": "DeepSeek V4 Pro: best price/performance for coding, 1M context. Metered, NOT free: $0.66/M input and $1.98/M output off-peak, doubled during peak hours (01:00-04:00 and 06:00-10:00 UTC, Mon-Fri) — schedule heavy batches outside that window."
    },
    "reasoning": {
      "description": "Complex reasoning, architecture, planning",
      "model": "anthropic/claude-opus-4-8",
      "small_model": "anthropic/claude-sonnet-4-6",
      "fallback": [
        "zai/glm-5.2",
        "openai/gpt-5.5",
        "deepseek/deepseek-v4-pro"
      ],
      "rationale": "Claude Opus 4.8: deepest reasoning, 1M context, tool use"
    },
    "fast": {
      "description": "Quick answers, exploration, compaction",
      "model": "deepseek/deepseek-flash",
      "small_model": "deepseek/deepseek-flash",
      "fallback": [
        "zai/glm-5-turbo",
        "google/gemini-3.5-flash",
        "groq/llama-4-maverick"
      ],
      "rationale": "DeepSeek Flash: fastest, cheapest metered tier, 1M context. Metered, NOT free: $0.15/M input and $0.60/M output off-peak ($0.003/M cache hit), doubled during peak hours (01:00-04:00 and 06:00-10:00 UTC, Mon-Fri)."
    },
    "agentic": {
      "description": "Tool use, multi-step workflows, autonomous agents",
      "model": "deepseek/deepseek-v4-pro",
      "small_model": "deepseek/deepseek-flash",
      "fallback": [
        "zai/glm-5.2",
        "anthropic/claude-opus-4-8"
      ],
      "rationale": "DeepSeek V4 Pro: best agentic tool use, 1M context. Metered, NOT free: $0.66/M input and $1.98/M output off-peak, doubled during peak hours (01:00-04:00 and 06:00-10:00 UTC, Mon-Fri)."
    },
    "budget": {
      "description": "Cost-sensitive tasks, bulk operations",
      "model": "zai/glm-5.2",
      "small_model": "zai/glm-5-turbo",
      "fallback": [
        "deepseek/deepseek-flash",
        "google/gemini-3.5-flash",
        "groq/llama-4-maverick"
      ],
      "rationale": "GLM-5.2: free tier, 1M context, open weights, strong coding"
    },
    "vision": {
      "description": "Image analysis, multimodal tasks",
      "model": "google/gemini-3.5-flash",
      "small_model": "google/gemini-3.1-flash-lite",
      "fallback": [
        "anthropic/claude-opus-4-8",
        "openai/gpt-5.5"
      ],
      "rationale": "Gemini 3.5 Flash: best multimodal, 1M context, free tier"
    },
    "isolated": {
      "description": "Air-gapped operation (Isolated Circuit Mode)",
      "model": "ollama/qwen3:32b",
      "small_model": "ollama/qwen3:14b",
      "fallback": [
        "ollama/qwen3:14b",
        "ollama/qwen3:1.8b"
      ],
      "rationale": "Qwen3 32B: best local coding model, fits in 20GB VRAM"
    },
    "ru_cn": {
      "description": "Optimized for Russian/Chinese language tasks",
      "model": "zai/glm-5.2",
      "small_model": "zai/glm-5-turbo",
      "fallback": [
        "deepseek/deepseek-v4-pro",
        "alibaba/qwen3.7-plus"
      ],
      "rationale": "GLM-5.2: best RU/CN language support, free tier, open weights"
    },
    "testing": {
      "description": "Test generation, QA, verification, coverage",
      "model": "deepseek/deepseek-flash",
      "small_model": "deepseek/deepseek-flash",
      "fallback": [
        "zai/glm-5.2",
        "groq/llama-4-maverick"
      ],
      "rationale": "RECONCILED 2026-08-17: ai-router.json routed testing→xai/grok-4.3 and swarm mapped test_engineer→opencode/gpt-5-nano. Unified to deepseek-flash (cheapest metered tier, high-volume/low-complexity; keep test batches inside the off-peak window where rates halve)."
    }
  },
