      "01:00-04:00",
      "06:00-10:00"
    ],
    "deepseek_peak_window_days": "Monday-Friday, excluding Chinese public holidays",
    "deepseek_off_peak": "Every hour outside deepseek_peak_window_utc on weekdays, plus weekends and Chinese public holidays in full.",
    "deepseek_rule": "Off-peak rates are half of the peak rates.",
    "verified": "2026-10-16",
    "source": "https://api-docs.deepseek.com/quick_start/pricing",
    "scheduling": "Batch LLM work (CI, test generation, repo maintenance, dependency updates) inside the off-peak window; .github/dependabot.yml is scheduled Sunday 05:00 UTC for exactly this reason.",
