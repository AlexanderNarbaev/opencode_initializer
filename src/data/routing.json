{
  "$schema": "https://opencode.ai/routing.json",
  "version": "1.1.0",
  "description": "v1.1.0 retires the deepseek-v4-flash alias (see retired_models), restates DeepSeek as metered with an off-peak/peak price split (see cost_policy), and marks minimax small_model explicitly unset. Single Source of Truth (SSOT) for task→model routing. Consolidates the three formerly divergent tables: 36-model-router.sh task-profiles.json, scripts/ai-router.json, and .opencode/opencode-swarm.json agent map. The providers section mirrors src/data/providers.json (routing-relevant fields only). See src/data/README.md.",
  "defaults": {
    "default_provider": "xiaomi-token-plan-sgp",
    "default_model": "xiaomi-token-plan-sgp/mimo-v2.6-pro",
    "fast_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
    "fallback_chain": [
      "xiaomi-token-plan-sgp",
      "minimax-coding-plan",
      "minimax",
      "deepseek"
    ],
    "policy": "Prepaid token plans first (Xiaomi MiMo, MiniMax). DeepSeek is pay-as-you-go: last-resort fallback only, deepseek-flash unless explicitly escalated to deepseek-v4-pro."
  },
  "retired_models": {
    "deepseek-v4-flash": {
      "replacement": "deepseek-flash",
      "status": "retired",
      "note": "Legacy alias still accepted by the API, but the model behind it was retired: requests are served by DeepSeek-V4.1-Flash and billed at the Flash price. Never route to the alias."
    },
    "deepseek-v4-flash-vision-exp": {
      "replacement": "deepseek-flash",
      "status": "retired",
      "note": "Retired alongside deepseek-v4-flash; use deepseek-flash."
    }
  },
  "complexity_rules": {
    "simple": {
      "max_tokens": 2000,
      "provider": "xiaomi-token-plan-sgp",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "cost_per_1k": 0.0,
      "examples": [
        "fix typo",
        "add comment",
        "rename variable",
        "format code"
      ]
    },
    "medium": {
      "max_tokens": 8000,
      "provider": "xiaomi-token-plan-sgp",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-pro",
      "cost_per_1k": 0.0,
      "examples": [
        "implement feature",
        "refactor module",
        "add tests",
        "write docs"
      ]
    },
    "complex": {
      "max_tokens": 64000,
      "provider": "minimax-coding-plan",
      "model": "minimax-coding-plan/MiniMax-M3",
      "thinking": true,
      "cost_per_1k": 0.0,
      "examples": [
        "design architecture",
        "debug deep issue",
        "security audit",
        "multi-file refactor"
      ]
    }
  },
  "task_routing": {
    "code_generation": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-pro"
    },
    "code_review": {
      "provider": "minimax-coding-plan",
      "model": "MiniMax-M3"
    },
    "testing": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-flash"
    },
    "documentation": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-flash"
    },
    "architecture": {
      "provider": "minimax-coding-plan",
      "model": "MiniMax-M3",
      "thinking": true
    },
    "security_audit": {
      "provider": "minimax-coding-plan",
      "model": "MiniMax-M3",
      "thinking": true
    },
    "devops": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-flash"
    },
    "ui_design": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-pro"
    },
    "research": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-pro",
      "thinking": true
    },
    "refactoring": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-pro"
    },
    "debugging": {
      "provider": "minimax-coding-plan",
      "model": "MiniMax-M3",
      "thinking": true
    },
    "data_analysis": {
      "provider": "xiaomi-token-plan-sgp",
      "model": "mimo-v2.6-pro"
    }
  },
  "task_profiles": {
    "coding": {
      "description": "Primary coding, implementation, refactoring",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-pro",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M3",
        "deepseek/deepseek-flash"
      ],
      "rationale": "Xiaomi MiMo-V2.6-Pro on the prepaid token plan: 1M context, no marginal cost. DeepSeek Flash is the paid fallback only."
    },
    "reasoning": {
      "description": "Complex reasoning, architecture, planning",
      "model": "minimax-coding-plan/MiniMax-M3",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "xiaomi-token-plan-sgp/mimo-v2.6-pro",
        "deepseek/deepseek-flash"
      ],
      "rationale": "MiniMax-M3 on the coding token plan for the deepest reasoning; Xiaomi Pro as the second prepaid route."
    },
    "fast": {
      "description": "Quick answers, exploration, compaction",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "deepseek/deepseek-flash"
      ],
      "rationale": "MiMo-V2.6-Flash: fastest prepaid tier for exploration, compaction and small edits."
    },
    "agentic": {
      "description": "Tool use, multi-step workflows, autonomous agents",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-pro",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M3",
        "deepseek/deepseek-flash"
      ],
      "rationale": "MiMo-V2.6-Pro: best prepaid agentic tool use, 1M context."
    },
    "budget": {
      "description": "Cost-sensitive tasks, bulk operations",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M3.1-Flash"
      ],
      "rationale": "Cheapest prepaid route; no paid fallback for bulk work."
    },
    "vision": {
      "description": "Image analysis, multimodal tasks",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-pro",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M3",
        "deepseek/deepseek-flash"
      ],
      "rationale": "MiMo-V2.6-Pro accepts text+image on the prepaid plan."
    },
    "isolated": {
      "description": "Offline / air-gapped work",
      "model": "ollama/qwen3:32b",
      "small_model": "ollama/qwen3:14b",
      "fallback": [],
      "rationale": "Local only; never reaches a cloud provider when ISOLATED_CIRCUIT=true."
    },
    "ru_cn": {
      "description": "Russian/Chinese language work",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-pro",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M3"
      ],
      "rationale": "MiMo-V2.6-Pro has strong ru/zh coverage on the prepaid plan."
    },
    "testing": {
      "description": "Test generation and fixes",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "deepseek/deepseek-flash"
      ],
      "rationale": "Fast prepaid model for routine test work; DeepSeek Flash only if plans fail."
    }
  },
