{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "enabled_providers": [
    "opencode-go",
    "minimax-coding-plan",
    "minimax",
    "xiaomi-token-plan-sgp",
    "deepseek",
    "opencode"
  ],
  "agents": {
    "build": {
      "mode": "primary",
      "temperature": 0.6
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1
    },
    "general": {
      "mode": "subagent",
      "temperature": 0.2
    },
    "explore": {
      "mode": "subagent",
      "temperature": 0.1
    },
    "code-reviewer": {
      "mode": "subagent",
      "temperature": 0.1
    },
    "compaction": {
      "mode": "primary",
      "hidden": true,
      "temperature": 0.1
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Strict review of a diff or file set: correctness, security, regressions, missing tests.",
      "system": "You are a senior reviewer. Read the diff and the surrounding code before judging. Report only defects you can point to (file:line), grouped as BLOCKER / MAJOR / MINOR, each with a concrete fix. Never rewrite the code unless asked; never invent APIs. If nothing is wrong, say so explicitly and list what you verified."
    },
    "docs": {
      "mode": "subagent",
      "description": "Writes and updates user-facing documentation (EN/RU pairs, MkDocs conventions).",
      "system": "You write documentation. Match the existing structure and tone; keep EN and RU pages in sync when a pair exists; use runnable commands with expected output; never document behaviour you have not verified in the code."
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 30000
    }
  },
  "skills": [
    "__HOME__/.config/opencode/skills"
  ],
  "lsp": {
    "typescript": {
      "command": [
        "__HOME__/.bun/bin/typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "pyright": {
      "command": [
        "__HOME__/.bun/bin/pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "gopls": {
      "command": [
        "__HOME__/go/bin/gopls",
        "serve"
      ],
      "extensions": [
        ".go"
      ]
    },
    "bash": {
      "command": [
        "__HOME__/.bun/bin/bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "yaml": {
      "command": [
        "__HOME__/.bun/bin/yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "json": {
      "command": [
        "__HOME__/.bun/bin/vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "css": {
      "command": [
        "__HOME__/.bun/bin/vscode-css-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".less"
      ]
    },
    "html": {
      "command": [
        "__HOME__/.bun/bin/vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "dockerfile": {
      "command": [
        "__HOME__/.bun/bin/docker-langserver",
        "--stdio"
      ],
      "extensions": [
        ".dockerfile"
      ]
    },
    "markdown": {
      "command": [
        "__HOME__/.bun/bin/vscode-markdown-language-server",
        "--stdio"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    }
  },
  "share": "disabled",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/mcp-server-filesystem",
        "__HOME__/Projects"
      ],
      "enabled": false
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/mcp-server-sequential-thinking"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/mcp-server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "__HOME__/.local/share/opencode/memory.json"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/context7-mcp"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/playwright-mcp"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/chrome-devtools-mcp"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "__HOME__/.local/bin/mcp-server-git"
      ]
    },
    "fetch": {
      "type": "local",
      "command": [
        "__HOME__/.local/bin/mcp-server-fetch"
      ],
      "enabled": false
    },
    "time": {
      "type": "local",
      "command": [
        "__HOME__/.local/bin/mcp-server-time"
      ]
    },
    "sqlite": {
      "type": "local",
      "command": [
        "__HOME__/.local/bin/mcp-server-sqlite",
        "--db-path",
        "__HOME__/.local/share/opencode/agent-memory.db"
      ],
      "enabled": false
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "__HOME__/.local/bin/github-mcp-server",
        "stdio"
      ],
      "enabled": false
    },
    "brave-search": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/bunx",
        "-y",
        "@brave/brave-search-mcp-server@2.1.4"
      ],
      "enabled": false
    },
    "notion": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/bunx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "qdrant": {
      "type": "local",
      "command": [
        "__HOME__/.local/bin/mcp-server-qdrant"
      ],
      "environment": {
        "QDRANT_URL": "http://127.0.0.1:6333",
        "COLLECTION_NAME": "opencode-memory",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "__HOME__/.bun/bin/bunx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://opencode:opencode@127.0.0.1:5432/opencode"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.2.0",
    "opencode-token-tracker@2.0.0",
    "opencode-auto-fallback@0.4.61",
    "opencode-supermemory@2.0.17",
    "opencode-swarm@7.197.3",
    "opencode-goal-plugin@0.11.0",
    "opencode-orchestrator@2.0.15"
  ],
  "$comment": "Template rendered by scripts/install-agentic-stack.sh — __HOME__ is replaced with the target HOME."
}
