{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "reserved": 10000
  },
  "provider": {
    "deepseek": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true
      },
      "fallback": [
        "opencode",
        "zai",
        "openrouter",
        "minimax"
      ]
    },
    "opencode": {
      "fallback": [
        "deepseek",
        "zai",
        "openrouter",
        "minimax"
      ]
    },
    "minimax": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "https://api.minimax.io/v1",
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "mimo": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:MIMO_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ],
      "models": {
        "mimo-v2.6-pro": {
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    },
    "zai": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "openrouter"
      ]
    },
    "openrouter": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "xai": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:XAI_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "openai": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "anthropic"
      ]
    },
    "anthropic": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "openai"
      ]
    },
    "google": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:GOOGLE_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "mistral": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:MISTRAL_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "openai"
      ]
    },
    "groq": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "together": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:TOGETHER_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "groq"
      ]
    },
    "cohere": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "fireworks": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "https://api.fireworks.ai/inference/v1",
        "apiKey": "{env:FIREWORKS_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "together"
      ]
    },
    "cerebras": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:CEREBRAS_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "groq"
      ]
    },
    "perplexity": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:PERPLEXITY_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "openai"
      ]
    },
    "alibaba": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "apiKey": "{env:ALIBABA_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "deepinfra": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "https://api.deepinfra.com/v1/openai",
        "apiKey": "{env:DEEPINFRA_API_KEY}"
      },
      "fallback": [
        "deepseek",
        "opencode",
        "zai"
      ]
    },
    "ollama": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "http://localhost:11434/v1"
      },
      "fallback": [
        "deepseek",
        "opencode"
      ]
    },
    "vllm": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "http://localhost:8000/v1"
      },
      "fallback": [
        "ollama",
        "deepseek",
        "opencode"
      ]
    },
    "sglang": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "http://localhost:30000/v1"
      },
      "fallback": [
        "ollama",
        "deepseek",
        "opencode"
      ]
    },
    "moonshotai": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true,
        "baseURL": "http://127.0.0.1:9876/v1",
        "apiKey": "not-needed-proxy-injects-key"
      },
      "default_model": "moonshotai/kimi-k3",
      "small_model": "moonshotai/kimi-k2.7-code",
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot Kimi (via local proxy)",
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "temperature": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "temperature": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code Highspeed",
          "temperature": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      },
      "fallback": [
        "deepseek"
      ]
    }
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "target/**",
      "__pycache__/**"
    ]
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "lsp": {
    "typescript": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "pyright": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "gopls": {
      "command": [
        "/home/alexandr-narbaev/go/bin/gopls",
        "serve"
      ],
      "extensions": [
        ".go"
      ]
    },
    "bash": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "yaml": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "json": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "css": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/vscode-css-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".less"
      ]
    },
    "html": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "dockerfile": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/docker-langserver",
        "--stdio"
      ],
      "extensions": [
        ".dockerfile"
      ]
    },
    "markdown": {
      "command": [
        "/home/alexandr-narbaev/.bun/bin/vscode-markdown-language-server",
        "--stdio"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    }
  },
  "plugin": [
    [
      "@tarquinen/opencode-dcp@3.2.0",
      {
        "compress": {
          "enabled": true,
          "minContextLimit": 500000,
          "maxContextLimit": 1000000,
          "autoCompaction": true
        },
        "prune": {
          "enabled": true,
          "protectTokens": 100000,
          "minTokens": 500000
        }
      }
    ],
    "opencode-token-tracker@2.0.0",
    "opencode-auto-fallback@0.4.61",
    "opencode-supermemory@2.0.17",
    "opencode-swarm@7.197.3",
    "opencode-goal-plugin@0.11.0",
    "opencode-orchestrator@2.0.15"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.3.0"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": false
    },
    "time": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-time"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/home/alexandr-narbaev/.bun/bin/mcp-server-filesystem",
        "/home/alexandr-narbaev/Projects/opencode_initializer"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "/home/alexandr-narbaev/.bun/bin/playwright-mcp"
      ],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": [
        "/home/alexandr-narbaev/.local/bin/github-mcp-server",
        "stdio"
      ],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/home/alexandr-narbaev/.bun/bin/mcp-server-sequential-thinking"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp"
      ]
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server@2.1.4"
      ],
      "enabled": false
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false,
      "timeout": 30000
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "timeout": 30000
    },
    "codegraph": {
      "type": "local",
      "command": [
        "/home/alexandr-narbaev/.bun/bin/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "qdrant": {
      "type": "local",
      "command": [
        "/home/alexandr-narbaev/.local/bin/mcp-server-qdrant"
      ],
      "environment": {
        "QDRANT_URL": "http://127.0.0.1:6333",
        "COLLECTION_NAME": "opencode-memory",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "/home/alexandr-narbaev/.bun/bin/bunx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://opencode:opencode@127.0.0.1:5432/opencode"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "temperature": 0.6
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1
    },
    "general": {
      "mode": "subagent",
      "temperature": 0.2
    },
    "explore": {
      "mode": "subagent",
      "temperature": 0.1
    },
    "code-reviewer": {
      "mode": "subagent",
      "temperature": 0.1
    },
    "compaction": {
      "mode": "primary",
      "hidden": true,
      "temperature": 0.1
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Strict review of a diff or file set: correctness, security, regressions, missing tests.",
      "system": "You are a senior reviewer. Read the diff and the surrounding code before judging. Report only defects you can point to (file:line), grouped as BLOCKER / MAJOR / MINOR, each with a concrete fix. Never rewrite the code unless asked; never invent APIs. If nothing is wrong, say so explicitly and list what you verified."
    },
    "docs": {
      "mode": "subagent",
      "description": "Writes and updates user-facing documentation (EN/RU pairs, MkDocs conventions).",
      "system": "You write documentation. Match the existing structure and tone; keep EN and RU pages in sync when a pair exists; use runnable commands with expected output; never document behaviour you have not verified in the code."
    }
  },
  "enabled_providers": [
    "opencode-go",
    "minimax-coding-plan",
    "minimax",
    "xiaomi-token-plan-sgp",
    "opencode"
  ]
}
