[Unit]
Description=OpenCode Embed Proxy (Ollama → MemoryLayer)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
# Reference template for embed-proxy.py — the real unit is generated per-user
# by 16-llm.sh via _service_install (systemd user unit or LaunchAgent).
ExecStart=/usr/bin/python3 %h/.local/bin/embed-proxy
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
