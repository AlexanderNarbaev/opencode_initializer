#!/usr/bin/env bash
# scripts/har — Meta-Harness CLI (v1.0.1)
# Unified harness combining opencode-ai + dsh (DeepSeek Harness) +
# sandcastle (sandboxed orchestration) + every opencode-* plugin.
# Single entrypoint: `har <cmd> [args...]`
#
# Inspired by iPolloWork's "two agent ecosystems, one workflow" model —
# but MIT-only and dependent on nothing proprietary.
#
# NOTE: opencode-context (v1.0.8) and opencode-router (v0.17.14) are
# NOT in the plugin array — they hang opencode agent list / stats.
# Installed via npm but loaded only on explicit user invocation.
set -euo pipefail

HAR_VERSION="1.0.1"
HAR_HOME="${HAR_HOME:-$HOME/.local/share/har}"
HAR_CACHE="${HAR_CACHE:-$HOME/.cache/har}"
HAR_LOG="${HAR_LOG:-$HAR_CACHE/har.log}"
mkdir -p "$HAR_HOME" "$HAR_CACHE"

HAR_OPENCODE="${HAR_OPENCODE:-opencode}"
HAR_DSH="${HAR_DSH:-dsh}"
HAR_SANDCASTLE_DIR="${HAR_SANDCASTLE_DIR:-$HOME/Projects/opencode_initializer/node_modules/@ai-hero/sandcastle}"
HAR_OPENCODE_JSON="${HAR_OPENCODE_JSON:-$HOME/.config/opencode/opencode.json}"
HAR_BUNDLE_JSON="${HAR_BUNDLE_JSON:-$HOME/.config/opencode/bundle.json}"
HAR_PROJECTS_DIR="${HAR_PROJECTS_DIR:-$HOME/Projects}"

# ── Pretty output ──────────────────────────────────────────────────────────
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_BLUE=$'\033[34m'; C_CYAN=$'\033[36m'
else
  C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_BLUE=""; C_CYAN=""
fi

log()   { echo "${C_CYAN}[har]${C_RESET} $*" | tee -a "$HAR_LOG" >&2; }
warn()  { echo "${C_YELLOW}[har:W]${C_RESET} $*" | tee -a "$HAR_LOG" >&2; }
err()   { echo "${C_RED}[har:E]${C_RESET} $*" | tee -a "$HAR_LOG" >&2; }
ok()    { echo "${C_GREEN}[har:OK]${C_RESET} $*" | tee -a "$HAR_LOG" >&2; }

# ── Subcommands ────────────────────────────────────────────────────────────

har_help() {
  cat <<'EOF'
har — Meta-Harness CLI for AI development (v1.0.1)

USAGE
  har <command> [args...]

COMMANDS
  status              Show health of opencode + dsh + plugins
  doctor              Run diagnostics and report issues + suggested fixes
  agents              List all 57 agents (primary + subagents)
  skills              List all 43 skills (SDD + Matt Pocock)
  plugins             List all installed opencode-* plugins
  mcp                 List all 16 MCP servers + their state
  lsp                 List all 12 LSP servers + their file extensions
  providers           List LLM providers with fallback chains
  context             Show context compaction policy (from opencode.json)
  runs                List recent agent runs (from ~/.cache/opencode/wal.jsonl)
  delegate <task>     Delegate task to dsh headless profile
  sandbox <task>      Run task in sandcastle sandbox
  opencode [args]     Pass through to opencode CLI
  dsh [args]          Pass through to dsh
  apply <project>     Apply opencode_initializer harness to a project
  apply-all           Apply to every project under $HAR_PROJECTS_DIR
  evolve              Self-improve: refresh skill mtimes across all projects
  web [port]          Start unified dashboard (dsh web on port, default 3080)
  update              Update all plugins + dsh to latest
  help                Show this help

ENV
  HAR_OPENCODE       opencode binary (default: opencode)
  HAR_DSH            dsh binary      (default: dsh)
  HAR_PROJECTS_DIR   where to look for projects
EOF
}

har_status() {
  log "Meta-harness v${HAR_VERSION} status"
  echo
  echo "Core"
  for pair in "opencode:$HAR_OPENCODE" "dsh:$HAR_DSH" "bun:bun" "node:node"; do
    label="${pair%%:*}"; bin="${pair#*:}"
    if command -v "$bin" >/dev/null 2>&1; then
      printf "  %-12s OK   %s (%s)\n" "$label" "$(command -v "$bin")" "$(${bin} --version 2>/dev/null | head -1)"
    else
      printf "  %-12s MISSING\n" "$label"
    fi
  done
  echo
  echo "Plugins (npm -g)"
  local count
  count="$(npm list -g --depth=0 2>/dev/null | grep -cE '^├── opencode-[a-z]')"
  echo "  installed: $count opencode-* packages"
  echo
  echo "Config"
  [ -f "$HAR_OPENCODE_JSON" ] && ok "opencode.json exists" || warn "opencode.json missing"
  [ -f "$HAR_BUNDLE_JSON" ]    && ok "bundle.json exists"    || warn "bundle.json missing"
  echo
  echo "Agents"
  if command -v "$HAR_OPENCODE" >/dev/null 2>&1; then
    local agents
    agents="$($HAR_OPENCODE agent list 2>/dev/null | grep -cE '^[a-z_-]+ \(')"
    echo "  total: $agents (run 'opencode agent list' for details)"
  fi
}

har_doctor() {
  log "Running diagnostics"
  local issues=0
  command -v "$HAR_OPENCODE" >/dev/null 2>&1 || { err "opencode CLI not found"; issues=$((issues+1)); }
  command -v "$HAR_DSH" >/dev/null 2>&1 || warn "dsh not found"
  [ -f "$HAR_OPENCODE_JSON" ] || { err "opencode.json missing"; issues=$((issues+1)); }
  if [ -f "$HAR_OPENCODE_JSON" ]; then
    python3 -c "import json; json.load(open('$HAR_OPENCODE_JSON'))" 2>/dev/null || { err "opencode.json invalid JSON"; issues=$((issues+1)); }
  fi
  for p in opencode-goal-mode opencode-goal-plugin opencode-orchestrator opencode-supermemory; do
    npm list -g "$p" >/dev/null 2>&1 || warn "$p missing — npm i -g $p"
  done
  [ -d "$HOME/.config/opencode" ] || { err "~/.config/opencode missing"; issues=$((issues+1)); }
  if [ "$issues" -eq 0 ]; then ok "No critical issues"; else err "$issues critical issues"; fi
  return $issues
}

har_agents() {
  command -v "$HAR_OPENCODE" >/dev/null 2>&1 || { err "opencode not available"; return 1; }
  $HAR_OPENCODE agent list 2>/dev/null | grep -E "^[a-z_-]+ \(" | sort
}

har_skills() {
  for dir in "$HOME/.config/opencode/skills" "$HOME/Projects/opencode_initializer/.opencode/skills"; do
    [ -d "$dir" ] && find "$dir" -maxdepth 2 -name "SKILL.md" -printf "%P\n" 2>/dev/null
  done | sort -u
}

har_plugins() { npm list -g --depth=0 2>/dev/null | grep -E "^├── opencode-[a-z]" | awk '{print $2}' | sed 's/@.*//'; }

har_mcp() {
  [ -f "$HAR_OPENCODE_JSON" ] && command -v python3 >/dev/null 2>&1 || { err "missing json/python"; return 1; }
  python3 -c "
import json
d=json.load(open('$HAR_OPENCODE_JSON'))
for name, cfg in d.get('mcp',{}).items():
    print(f\"  {'OK' if cfg.get('enabled', True) else 'off'}  {name}  ({cfg.get('type','?')})\")
"
}

har_lsp() {
  [ -f "$HAR_OPENCODE_JSON" ] && command -v python3 >/dev/null 2>&1 || { err "missing json/python"; return 1; }
  python3 -c "
import json
d=json.load(open('$HAR_OPENCODE_JSON'))
for name, cfg in d.get('lsp',{}).items():
    exts = ','.join(cfg.get('extensions',[]))
    cmd  = cfg.get('command',['?'])[0]
    print(f\"  {name:24s}  {cmd:30s}  {exts}\")
"
}

har_providers() {
  [ -f "$HAR_OPENCODE_JSON" ] && command -v python3 >/dev/null 2>&1 || return 1
  python3 -c "
import json
d=json.load(open('$HAR_OPENCODE_JSON'))
for name, cfg in d.get('provider',{}).items():
    fb = ','.join(cfg.get('fallback',[]))
    print(f\"  {name:14s}  fallback: {fb}\")
"
}

har_context() {
  [ -f "$HAR_OPENCODE_JSON" ] && command -v python3 >/dev/null 2>&1 || return 1
  python3 -c "
import json
d=json.load(open('$HAR_OPENCODE_JSON'))
c=d.get('compaction',{})
print(f\"  compaction: auto={c.get('auto')}, prune={c.get('prune')}, tail={c.get('tail_turns')}, reserved={c.get('reserved')}\")
print(f\"  model:       {d.get('model','')}\")
print(f\"  small_model: {d.get('small_model','')}\")
"
  warn "live token usage: run inside OpenCode TUI/CLI"
}

har_delegate() { log "Delegating to dsh headless: $*"; $HAR_DSH --profile headless "$@"; }

har_sandbox() {
  if [ -d "$HAR_SANDCASTLE_DIR" ]; then
    log "Running in sandcastle sandbox: $*"
    ( cd "$HAR_SANDCASTLE_DIR" && node -e "
const { run } = require('./dist/index.js');
run({ prompt: process.argv.slice(2).join(' '), sandbox: 'docker' }).then(r => console.log(JSON.stringify(r))).catch(e => { console.error(e); process.exit(1); });
" "$@" )
  else
    err "Sandcastle not at $HAR_SANDCASTLE_DIR — install @ai-hero/sandcastle"
    return 1
  fi
}

har_opencode() { command "$HAR_OPENCODE" "$@"; }
har_dsh()      { command "$HAR_DSH"      "$@"; }

har_plugin() {
  local name="${1:-}"; shift || true
  case "$name" in
    list) har_plugins ;;
    status) npm list -g "opencode-$name" 2>/dev/null ;;
    enable|disable|log) warn "Plugin control via opencode.json plugin array — edit manually" ;;
    *) err "Usage: har plugin <name> <list|status|enable|disable|log>"; return 2 ;;
  esac
}

har_evolve() {
  log "Self-improve: refresh skill mtimes"
  for d in "$HAR_PROJECTS_DIR"/*/; do
    [ -d "$d/.opencode" ] || continue
    find "$d/.opencode/skills" -name "SKILL.md" -exec touch {} \; 2>/dev/null || true
    echo "  → $d"
  done
  ok "Touched all SKILL.md files"
}

har_web() {
  local port="${1:-3080}"
  log "Starting unified dashboard on http://127.0.0.1:${port}"
  $HAR_DSH web --port "$port" &
  echo $! > "$HAR_CACHE/har-web.pid"
  ok "har web started (pid $!). Stop: kill \$(cat $HAR_CACHE/har-web.pid)"
}

har_update() {
  log "Updating all harness components"
  npm install -g \
    opencode-context@latest \
    opencode-router@latest \
    opencode-supermemory@latest \
    opencode-token-tracker@latest \
    opencode-vibeguard@latest \
    opencode-auto-fallback@latest \
    opencode-dcp@latest \
    opencode-goal-mode@latest \
    opencode-goal-plugin@latest \
    opencode-orchestrator@latest \
    opencode-codegraph@latest \
    opencode-snippets@latest \
    @deepseek-ai/dsh@latest 2>&1 | tail -10
  warn "opencode-context + opencode-router stay installed but NOT in plugin[] (hangs agent list)"
}

har_apply() {
  local target="${1:-}"
  [ -n "$target" ] || { err "Usage: har apply <project-path>"; return 2; }
  [ -d "$target" ] || { err "Not a directory: $target"; return 2; }
  log "Applying harness to $target"
  mkdir -p "$target/.opencode/skills"
  local src="/home/alexandr-narbaev/Projects/opencode_initializer/.opencode/skills"
  [ -d "$src" ] && rsync -a --update "$src/" "$target/.opencode/skills/" && ok "Skills synced"
}

har_apply_all() {
  for d in "$HAR_PROJECTS_DIR"/*/; do
    [ -d "$d" ] || continue
    har_apply "$d"
  done
}

# ── Dispatcher ─────────────────────────────────────────────────────────────
cmd="${1:-help}"; shift || true
case "$cmd" in
  help|--help|-h) har_help ;;
  status|health) har_status ;;
  doctor) har_doctor ;;
  agents) har_agents ;;
  skills) har_skills ;;
  plugins) har_plugins ;;
  mcp) har_mcp ;;
  lsp) har_lsp ;;
  providers) har_providers ;;
  context|ctx) har_context ;;
  delegate) har_delegate "$@" ;;
  sandbox) har_sandbox "$@" ;;
  opencode|oc) har_opencode "$@" ;;
  dsh) har_dsh "$@" ;;
  plugin) har_plugin "$@" ;;
  evolve) har_evolve ;;
  web|dashboard) har_web "$@" ;;
  update) har_update ;;
  apply-all|apply_all) har_apply_all ;;
  apply) har_apply "$@" ;;
  version|--version|-v) echo "har ${HAR_VERSION}" ;;
  *) err "Unknown command: $cmd"; har_help; exit 2 ;;
esac